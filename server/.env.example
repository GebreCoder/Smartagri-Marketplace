# ── Server ────────────────────────────────────────────────
PORT=5000
# Base URL the client uses to reach this server (used to build absolute
# image URLs when the frontend is served from a different origin).
PUBLIC_URL=http://localhost:5000

# ── PostgreSQL (smartagri_db) ─────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smartagri_db
# Or individual values (DATABASE_URL wins if present):
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=postgres
# PG_DATABASE=smartagri_db

# ── Auth ──────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── AI Chatbot (Groq primary, Gemini fallback) ───────────
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# ── Chapa payment gateway (https://dashboard.chapa.co) ─────
# Leave empty to keep the simulated batch payment. Test keys
# start with SECK_TEST- / PUBK_TEST-. Production keys start
# with SECK- / PUBK-.
CHAPA_SECRET_KEY=
# Optional — set the same secret hash configured in the Chapa
# dashboard (Settings → Webhooks) to verify webhook signatures.
CHAPA_WEBHOOK_VERIFY_HASH=
# Override only for a custom Chapa API base.
# CHAPA_API_BASE=https://api.chapa.co/v1

# ── Seed (npm run seed) ───────────────────────────────────
SEED_ADMIN_NAME=Admin AgriSpark
SEED_ADMIN_EMAIL=admin@agrispark.com
SEED_ADMIN_PASSWORD=admin1234
